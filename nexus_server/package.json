{
  "name": "nexus_server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && npx tsc && cpx \"src/seed/data/**/*\" dist/seed/data",
    "start": "node dist/index.js",
    "dev": "npm run build && concurrently \"npx tsc -w\" \"nodemon --exec ts-node src/index.ts\"",
    "seed": "ts-node src/seed/seedMongoDB.ts",
    "seed:dynamodb": "ts-node src/seed/seedDynamodb.ts",
    "check-accounts": "ts-node src/seed/checkAccounts.ts",
    "setup-accounts": "ts-node src/seed/setupAccounts.ts",
    "assign-courses": "ts-node src/seed/assignCoursesToUser.ts",
    "list-courses": "ts-node src/seed/listCourses.ts",
    "update-teacher": "ts-node src/seed/updateUserToTeacher.ts",
    "check-user": "ts-node src/seed/checkUserMetadata.ts",
    "update-course": "ts-node src/seed/updateCourseVideos.ts",
    "show-course": "ts-node src/seed/showCourseDetails.ts",
    "setup-showcase": "ts-node src/seed/setupShowcaseAccounts.ts",
    "assign-showcase": "ts-node src/seed/assignCoursesToShowcase.ts",
    "setup-accounts-old": "ts-node src/seed/setupSpecificAccounts.ts",
    "assign-accounts": "ts-node src/seed/assignToSpecificAccounts.ts",
    "check-nightraven": "ts-node src/seed/checkNightraven.ts",
    "docker:build": "docker build -t nexus-backend .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.920.0",
    "@clerk/express": "^1.7.43",
    "aws-sdk": "^2.1692.0",
    "body-parser": "^2.2.0",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "dynamoose": "^4.0.4",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pluralize": "^8.0.0",
    "serverless-http": "^4.0.0",
    "stripe": "^19.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.2",
    "@types/pluralize": "^0.0.33",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "cpx": "^1.5.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
