# ==============================================
# NEXUS LMS - Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=8001
NODE_ENV=development
# Options: development | production

# ==============================================
# CLERK AUTHENTICATION
# ==============================================
# Get these from: https://dashboard.clerk.com/
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ==============================================
# AWS CREDENTIALS (for DynamoDB)
# ==============================================
# For local development (DynamoDB Local):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey

# For production (Real AWS DynamoDB) - Comment out the fake ones above:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_real_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_real_aws_secret_key

# ==============================================
# CLOUDINARY (Video Storage)
# ==============================================
# Sign up for free at: https://cloudinary.com/
# Free tier: 25GB storage + 25GB bandwidth/month
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ==============================================
# PAYMENT CONFIGURATION
# ==============================================
# Currently using DEMO payment system (no real charges)
# Payment provider is set to "demo" in the code
# If you want to enable real payments in the future:
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret

# ==============================================
# CORS CONFIGURATION (Optional)
# ==============================================
# Add your frontend URL for production
FRONTEND_URL=http://localhost:3000
# For production: https://your-app.vercel.app

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# For local development with DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000

# For Railway deployment with DynamoDB Local in Docker:
# DYNAMODB_ENDPOINT=http://dynamodb-local:8000

# For production with AWS DynamoDB (leave empty to use AWS default):
# DYNAMODB_ENDPOINT=
