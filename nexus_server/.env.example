# ==============================================
# NEXUS LMS - Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your actual values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=8001
NODE_ENV=development
# Options: development | production

# ==============================================
# MONGODB ATLAS
# ==============================================
# Sign up for free at: https://www.mongodb.com/cloud/atlas
# Free tier: M0 cluster with 512MB storage
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ==============================================
# CLERK AUTHENTICATION
# ==============================================
# Get these from: https://dashboard.clerk.com/
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ==============================================
# CLOUDINARY (Video Storage)
# ==============================================
# Sign up for free at: https://cloudinary.com/
# Free tier: 25GB storage + 25GB bandwidth/month
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Your frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# For production: https://nexus-beta-two.vercel.app/

# ==============================================
# QA / TESTER ACCOUNTS
# ==============================================
# Password used by src/seed/createTesterAccounts.ts to create
# dedicated demo/QA teacher+student Clerk accounts. Pick your own
# value - never reuse a real account's password here.
TESTER_PASSWORD=choose_your_own_password_here

# ==============================================
# NOTES
# ==============================================
# - Never commit your actual .env file to version control
# - Keep your secrets safe and rotate them regularly
# - For production deployment (Render/Railway/etc), add these
#   as environment variables in your hosting platform's dashboard
