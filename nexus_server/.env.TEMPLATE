# ==============================================
# NEXUS SERVER - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=8001
NODE_ENV=development

# ==============================================
# CLERK AUTHENTICATION
# ==============================================
# Get from: https://dashboard.clerk.com/ → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ==============================================
# DATABASE - DynamoDB Local (Development)
# ==============================================
# For local development with DynamoDB Local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fakeMyKeyId
AWS_SECRET_ACCESS_KEY=fakeSecretAccessKey
DYNAMODB_ENDPOINT=http://localhost:8000

# ==============================================
# DATABASE - AWS DynamoDB (Production)
# ==============================================
# Uncomment and use these for production (requires AWS account)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_real_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_real_aws_secret_key
# DYNAMODB_ENDPOINT=  (leave empty for AWS)

# ==============================================
# CLOUDINARY (Video Storage)
# ==============================================
# Sign up for free at: https://cloudinary.com/
# Free tier: 25GB storage + 25GB bandwidth/month
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ==============================================
# FRONTEND URL (Optional)
# ==============================================
# For CORS configuration
FRONTEND_URL=http://localhost:3000
# Production: https://your-app.vercel.app
